{
    "name": "backrooms",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "dev:api": "tsx watch server/index.ts",
        "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
        "start": "node dist-server/server/index.js",
        "test": "vitest run",
        "lint": "eslint . && biome lint .",
        "lint:fix": "biome lint --write . && eslint --fix .",
        "format": "biome format --write . && eslint --fix .",
        "format:check": "biome format . && eslint .",
        "check": "biome check . && eslint ."
    },
    "dependencies": {
        "@fastify/static": "^10.1.5",
        "fastify": "^5.12.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.12.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    }
}
