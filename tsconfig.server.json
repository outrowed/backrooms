{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "outDir": "dist-server",
        "rootDir": "."
    },
    "include": ["server", "shared", "src"],
    "exclude": ["src/main.tsx"]
}
